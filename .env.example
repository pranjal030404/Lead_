# ---------------------------------------------------------------------------
# Arthvex LeadGen - configuration
# Copy this file to .env and fill it in. NEVER commit .env (see .gitignore).
# ---------------------------------------------------------------------------

# --- Auth (Part 7.5) -------------------------------------------------------
# If ADMIN_PASSWORD is blank a random one is generated and printed on startup.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Used to sign session cookies. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_HOURS=168
# Set true once you're behind HTTPS. Leave false for local http, or the browser
# silently drops the session cookie and login looks broken.
COOKIE_SECURE=false
# Turn on ONLY when a reverse proxy sits in front (the shipped Caddyfile does).
# It makes rate limits key on X-Forwarded-For instead of the proxy's own IP.
# Unproxied, that header is attacker-controlled - leave it false.
TRUST_PROXY=false

# --- Scale & limits --------------------------------------------------------
# Raise these as volume grows. Defaults suit one operator on a $4 VPS.
API_RATE_LIMIT=600
API_RATE_WINDOW=60
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW=300
MAX_PAGE_SIZE=500
# Enrichment is I/O-bound waiting on other people's web servers, so this is
# worth raising well past core count. It also bounds SQLite write contention.
ENRICH_WORKERS=8
HTTP_POOL_SIZE=32

# --- Database tuning (raise before reaching for Postgres) -----------------
DB_TIMEOUT=30
# NORMAL stops an fsync on every commit and is the standard pairing for WAL.
# An OS crash can lose the last few transactions; it cannot corrupt the file.
# Use FULL if you'd rather have the fsync.
DB_SYNCHRONOUS=NORMAL
DB_CACHE_MB=64
DB_MMAP_MB=256

# --- Data provider ---------------------------------------------------------
# osm    = OpenStreetMap Overpass (free, no key, no billing)   <- default
# google = Google Places API (New), needs GOOGLE_API_KEY
# mock   = offline generator, for demos and tests
PROVIDER=osm
GOOGLE_API_KEY=

# --- Location / "search near me" ------------------------------------------
# Which service names a coordinate. osm = free Nominatim (default).
# google bills per lookup and needs GOOGLE_API_KEY - it is never automatic.
GEOCODER=osm
NEARBY_RADIUS_M=3000
MAX_NEARBY_RADIUS_M=50000

# --- API quota hard stop (Part 7.2) ---------------------------------------
# This is the SECOND layer. Also set a Requests-per-day Quota limit in the
# Google Cloud Console - budget alerts alone do NOT stop spending.
MAX_GOOGLE_CALLS_PER_DAY=500
MAX_RESULTS_PER_SEARCH=60
QUOTA_WARN_PCT=80

# Stage 3 (Enterprise-tier fields: rating/reviews) is only fetched for leads
# that already scored at or above this after Stage 2. See Part 9.2.
ENTERPRISE_FETCH_MIN_SCORE=5

# --- Enrichment ------------------------------------------------------------
HTTP_TIMEOUT=8
WEBSITE_CACHE_DAYS=30
HUNTER_API_KEY=
MAX_HUNTER_CALLS_PER_MONTH=25

# --- Outreach sending (Part 8.6) ------------------------------------------
# Nothing is ever sent without approval in the UI. On top of that, DRY_RUN
# logs what would have been sent instead of sending it. Leave true for a week.
DRY_RUN=true
RESEND_API_KEY=
MAIL_FROM=you@yourdomain.com
MAIL_FROM_NAME=Your Name
MAX_EMAILS_PER_HOUR=20
UNSUBSCRIBE_MAILTO=you@yourdomain.com

# --- Operator alerts (Part 7.6) -------------------------------------------
# Mail to YOU, not to prospects: a new HOT lead, an API budget about to run
# out, and the daily health-check digest. These deliberately ignore DRY_RUN and
# the suppression list - a dry run you get no reports from isn't a test, and
# your own health check must not be silenceable. Needs RESEND_API_KEY set.
ALERTS_ENABLED=true
# Where alerts go. Falls back to MAIL_FROM when blank.
ALERT_EMAIL=
# Blueprint 7.6 says "9-10", but 9 is unreachable: the only rule that lifts a
# lead past 8 needs socials scraped from a website an ideal prospect doesn't
# have. 8 is the top of the real range and the HOT boundary.
HOT_ALERT_MIN_SCORE=8

# --- Automation (Part 8) ---------------------------------------------------
AUTOMATION_ENABLED=false
DISCOVERY_TIME=06:00
ENRICHMENT_TIME=06:30
SCORING_TIME=07:00
FOLLOWUP_TIME=07:30
DIGEST_TIME=08:00
BACKUP_TIME=02:00
TARGETS_PER_RUN=3
BACKUP_KEEP_DAYS=30

# --- Off-site backup sync (Part 7.4) --------------------------------------
# A local backup survives losing the file, not losing the box. Blank disables
# this. Set up an rclone remote first (`rclone config`), then point at it -
# e.g. b2:my-bucket/leadgen or gdrive:backups/leadgen.
BACKUP_REMOTE=
RCLONE_PATH=rclone
BACKUP_SYNC_TIMEOUT=300

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
